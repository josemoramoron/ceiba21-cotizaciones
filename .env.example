# Base de datos
DATABASE_URL=

# Redis (opcional — vacío = localhost:6379, db 0 para cache/rate-limit y
# db 1 para sesiones, igual que siempre)
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_SESSION_DB=

# Flask
SECRET_KEY=
FLASK_ENV=development

# Telegram (desactivado en dev)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CONVERSATIONAL_BOT_TOKEN=

# Credenciales de administrador dashboard
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Gmail IMAP (para ingesta de pagos)
GMAIL_IMAP_USER=ceiba21.oficial@gmail.com
GMAIL_IMAP_PASSWORD= #dev y prod pueden compertir la misma cuenta de correo para enviar mails, pero no es recomendable. Mejor crear una cuenta de correo para dev y otra para prod.
DEFAULT_LOCAL_CURRENCY=VES                 # Moneda local por defecto para cálculo

# ── Módulo SMS (gateway Android) ──
SMS_GATEWAY_IP=
SMS_GATEWAY_PORT=
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=

# --- Pega esto en tu .env (dev y prod) ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=

# --- Token de verificacion de correo de usuarios registrado ---

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD= #dev y prod pueden compertir la misma cuenta de correo para enviar mails, pero no es recomendable. Mejor crear una cuenta de correo para dev y otra para prod.
MAIL_DEFAULT_SENDER=Ceiba21 <info@ceiba21.com>
MAIL_REPLY_TO=info@ceiba21.com
MAIL_SUPPRESS_SEND=true